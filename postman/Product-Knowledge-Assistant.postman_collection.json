        {
          "name": "Amazfit Bip 5 warranty",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the warranty on the Amazfit Bip 5?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ask"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Product is found', () => pm.expect(pm.response.json().found).to.eql(true));",
                  "pm.test('Warranty is grounded', () => pm.expect(pm.response.json().answer.toLowerCase()).to.include('12 months'));"
                ]
              }
